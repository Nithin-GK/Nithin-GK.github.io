---
layout: default
---
{% assign project = site.data.research_projects[page.project_key] %}
<link rel="stylesheet" href="{{ '/assets/css/research-projects.css' | relative_url }}">
<article class="research-project-page">
  <a class="project-back" href="{{ '/projects/' | relative_url }}">Back to projects</a>
  <header class="research-project-header">
    <p class="project-meta">
      {% if project.company %}
        {{ project.company }} · {{ project.role }} · {{ project.period }}
      {% else %}
        {{ project.venue }}
        {{ project.year }}
      {% endif %}
    </p>
    <h1>{{ project.title }}</h1>
    <p class="project-lede">{{ project.introduction | default: project.description }}</p>
  </header>
  {% if project.definition %}
    <section class="project-definition">
      <h2>{{ project.definition_title }}</h2>
      <p>{{ project.definition }}</p>
      {% if project.attention_transfer_equations %}
        <div class="attention-equations">
          <p role="math" aria-label="Edited target keys equal the mask times target keys plus one minus the mask times source keys">
            <var>K̂</var><sub>t</sub> = <var>M</var> ⊙ <var>K</var><sub>t</sub> + (1 − <var>M</var>) ⊙ <var>K</var><sub>s</sub>
          </p>
          <p role="math" aria-label="Edited target values equal the mask times target values plus one minus the mask times source values">
            <var>V̂</var><sub>t</sub> = <var>M</var> ⊙ <var>V</var><sub>t</sub> + (1 − <var>M</var>) ⊙ <var>V</var><sub>s</sub>
          </p>
        </div>
      {% endif %}
      {% if project.definition_mask %}
        <p>{{ project.definition_mask }}</p>
      {% endif %}
      {% if project.definition_context %}
        <p>{{ project.definition_context }}</p>
      {% endif %}
    </section>
  {% endif %}
  {% if project.slides.size > 0 %}
    {% include research-slides.liquid slides=project.slides label=project.title %}
  {% endif %}
  {% if project.links.size > 0 %}
    <div class="project-links">
      {% for link in project.links -%}
        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
      {%- endfor %}
    </div>
  {% endif %}
  {% if project.method_steps %}
    <section class="project-method">
      <h2>How it works</h2>
      <ol>
        {% for step in project.method_steps %}
          <li>{{ step }}</li>
        {% endfor %}
      </ol>
    </section>
  {% endif %}
  {% if project.results %}
    <section class="project-results">
      <h2>{{ project.results_title | default: 'Results' }}</h2>
      {% for result in project.results %}
        <p>{{ result }}</p>
      {% endfor %}
      {% if project.results_context %}
        <p>{{ project.results_context }}</p>
      {% endif %}
    </section>
  {% endif %}
  <section class="project-contribution">
    <h2>{{ project.contributions_title | default: 'Contributions' }}</h2>
    <ul>
      {% for contribution in project.contributions %}
        <li>{{ contribution }}</li>
      {% endfor %}
    </ul>
  </section>
  {% if project.paper_title %}
    <p class="project-citation">
      {% if project.source_url -%}
        <a href="{{ project.source_url }}" target="_blank" rel="noopener noreferrer">{{ project.paper_title }}</a>
      {%- else -%}
        {{- project.paper_title -}}
      {%- endif -%}
      . {{ project.venue }}
      {{ project.year }}.
    </p>
  {% endif %}
</article>
<script src="{{ '/assets/js/research-slides.js' | relative_url }}" defer></script>
