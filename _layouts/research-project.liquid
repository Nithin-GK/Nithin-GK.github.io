---
layout: project-showcase
---
{% assign project = site.data.research_projects[page.project_key] %}
{% assign story = site.data.project_showcase[page.project_key] %}
<article class="case-study">
  <header class="case-hero">
    <div class="showcase-container">
      <a class="case-back" href="{{ '/projects/' | relative_url }}">← All projects</a>
      <p class="showcase-eyebrow">
        {% if project.company -%}
          {{- project.company }}
          {{ project.period -}}
          {%- unless project.presentation_status %}
            · {{ project.venue }}
            {{ project.year -}}
          {%- endunless -%}
        {%- else -%}
          {{- project.venue }}
          {{ project.year -}}
        {%- endif %}
        {%- if project.presentation_status %} · {{ project.presentation_status }}{% endif %}
      </p>
      <h1>{{ project.title }}</h1>
      <p class="case-pitch">{{ story.pitch }}</p>
      <p class="case-role">{{ story.role }}</p>
      <nav class="case-section-nav" aria-label="Case study sections">
        <a href="#examples">Figures</a><a href="#method">How it works</a><a href="#results">Results</a><a href="#slides">Presentation</a>
        {%- for link in project.links -%}
          <a class="case-source-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }} ↗</a>
        {%- endfor %}
      </nav>
    </div>
  </header>
  <div class="showcase-container case-body">
    <section class="case-examples" id="examples" aria-labelledby="examples-heading">
      <div class="case-section-heading">
        <h2 id="examples-heading">Figures</h2>
      </div>
      {% if story.edit_panels %}
        <div class="case-edit-grid">
          {% for figure in story.edit_panels -%}
            {%- include case-figure.liquid figure=figure -%}
          {%- endfor %}
        </div>
        <p class="case-media-caption">{{ story.edit_caption }}</p>
      {% endif %}
      <div
        class="case-example-grid"
        {% if story.media_ratio %}
          style="--case-media-ratio: {{ story.media_ratio }}"
        {% endif %}
      >
        {% for figure in story.media -%}
          {%- include case-figure.liquid figure=figure -%}
        {%- endfor %}
      </div>
    </section>
    <section class="case-section" id="method">
      <div class="case-section-heading">
        <h2>How it works</h2>
      </div>
      {% if story.method_details %}
        {% for detail in story.method_details %}
          <div class="case-method-detail">
            <h3>{{ detail.title }}</h3>
            <p>{{ detail.body }}</p>
          </div>
        {% endfor %}
        {% if story.composition_equations %}{% include unite-equations.liquid %}{% endif %}
      {% else %}
        <ol class="case-method-steps">
          {% for step in project.method_steps %}
            <li>
              <p>{{ step }}</p>
            </li>
          {% endfor %}
        </ol>
      {% endif %}
      {% if story.method_figures %}
        <div class="case-method-figures">
          {% for figure in story.method_figures -%}
            {%- include case-figure.liquid figure=figure -%}
          {%- endfor %}
        </div>
      {% endif %}
      {% if project.definition and story.method_details == null or project.attention_transfer_equations %}
        <div class="case-technical">
          <h3>{{ project.definition_title }}</h3>
          <p>{{ project.definition }}</p>
          {% if project.attention_transfer_equations %}
            <div class="case-equations">
              <p role="math" aria-label="Target keys inside the mask, source keys outside it">
                K̂<sub>t</sub> = M ⊙ K<sub>t</sub> + (1 − M) ⊙ K<sub>s</sub>
              </p>
              <p role="math" aria-label="Target values inside the mask, source values outside it">
                V̂<sub>t</sub> = M ⊙ V<sub>t</sub> + (1 − M) ⊙ V<sub>s</sub>
              </p>
            </div>
            <p>{{ project.definition_mask }}</p>
          {% endif -%}
          {%- if project.definition_context %}
            <p>{{ project.definition_context }}</p>
          {% endif %}
        </div>
      {% endif %}
    </section>
    <section class="case-section case-evidence" id="results" aria-labelledby="results-heading">
      <div class="case-section-heading">
        <h2 id="results-heading">Results</h2>
      </div>
      {% if story.evidence %}
        <p class="case-evidence-intro">{{ story.evidence_intro }}</p>
      {% endif %}
      {% if page.project_key == 'crowddiff' %}
        <div class="crowd-explorer" data-crowd-explorer>
          <div>
            <h3>Counting accuracy and runtime</h3>
            <p>Choose the number of sampled hypotheses from the published ablation.</p>
            <div class="crowd-choices" role="group" aria-label="Number of crowd hypotheses">
              {% assign hypotheses = '1,2,4,8' | split: ',' -%}
              {%- for count in hypotheses -%}
                <button type="button" data-hypotheses="{{ count }}" aria-pressed="{% if count == '4' %}true{% else %}false{% endif %}">
                  {{ count }}
                </button>
              {%- endfor %}
            </div>
          </div>
          <div class="crowd-readouts" role="status" aria-live="polite">
            <p><strong data-crowd-mae>68.95</strong><span>Average counting error (people)</span></p>
            <p><strong data-crowd-time>770 ms</strong><span>Reported inference time</span></p>
          </div>
        </div>
      {% endif %}
      {% if story.evidence %}
        {% include case-evidence.liquid evidence=story.evidence label=project.title %}
        {% for evidence in story.additional_evidence -%}
          {%- include case-evidence.liquid evidence=evidence label=project.title -%}
        {%- endfor %}
      {% else %}
        <p class="case-readable">{{ story.qualitative_result | default: story.evidence_intro }}</p>
      {% endif %}
      <div class="case-context">
        <p>{{ story.caveat }}</p>
      </div>
    </section>
    <section class="case-section case-slides" id="slides">
      <div class="case-section-heading">
        <h2>Presentation</h2>
      </div>
      {% include research-slides.liquid slides=project.slides label=project.title %}
    </section>
    <footer class="case-reference">
      {% if project.source_url -%}
        <a href="{{ project.source_url }}" target="_blank" rel="noopener noreferrer">{{ project.paper_title }} ↗</a>
      {%- else -%}
        {{- project.paper_title -}}
      {%- endif %}
      <p>
        {{ project.venue }}
        {{ project.year -}}
        {%- if project.presentation_status %} · {{ project.presentation_status }}{% endif %}
      </p>
      <a class="showcase-project-link" href="{{ '/projects/' | relative_url }}">All projects ↗</a>
      {% include showcase-credit.liquid %}
    </footer>
  </div>
</article>
<dialog class="case-lightbox" aria-label="Expanded research figure" data-figure-dialog>
  <button type="button" data-close-figure aria-label="Close expanded figure">Close ×</button><img alt="" data-dialog-image>
  <p data-dialog-caption></p>
</dialog>
<script src="{{ '/assets/js/research-slides.js' | relative_url }}" defer></script>
