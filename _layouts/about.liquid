---
layout: default
---
<article class="research-home">
  <header class="research-intro">
    <h1 class="intro-heading">{{ site.title }}</h1>
    {% if page.profile.image %}
      <img class="intro-portrait" src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" width="500" height="422" alt="Nithin Gopalakrishnan Nair" fetchpriority="high">
    {% endif %}
    <div class="intro-bio">{{ content }}</div>
    <nav class="intro-links" aria-label="Contact and profiles">
      {% assign socials = site.data.socials %}
      <a href="mailto:{{ socials.email }}">Email</a>
      <a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}">Google Scholar</a>
      <a href="https://github.com/{{ socials.github_username }}">GitHub</a>
      <a href="https://www.linkedin.com/in/{{ socials.linkedin_username }}/">LinkedIn</a>
      <a href="https://x.com/{{ socials.x_username }}">X</a>
    </nav>
  </header>
  {% if page.selected_papers %}
    <section aria-labelledby="selected-publications">
      <div class="papers-heading">
        <h2 id="selected-publications">Selected publications</h2>
        <a href="{{ '/publications/' | relative_url }}">All publications</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}
</article>
