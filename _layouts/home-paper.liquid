---
---
{% assign preview = site.data.home_previews[entry.key] %}
{% assign project = site.projects | where: 'project_key', preview.project | first %}
<article class="home-paper" id="{{ entry.key }}">
  {% if preview.poster %}
    {% assign figure_url = preview.poster | relative_url | bust_file_cache %}
    {% assign full_figure_url = figure_url %}
    {% if preview.full %}{% assign full_figure_url = preview.full | relative_url | bust_file_cache %}{% endif %}
    <a class="paper-figure" href="{{ full_figure_url }}" aria-label="Open full-size figure for {{ entry.title | strip_html | escape }}">
      <img class="paper-preview" src="{{ figure_url }}" alt="{{ preview.alt | escape }}" width="{{ preview.width }}" height="{{ preview.height }}" loading="lazy" decoding="async">
    </a>
  {% endif %}
  <div class="paper-copy">
    <p class="paper-venue">{{ entry.abbr | default: entry.year }}</p>
    <h3><a href="{% if project %}{{ project.url | relative_url }}{% elsif entry.pdf %}{{ entry.pdf }}{% else %}{{ '/publications/' | relative_url }}#{{ entry.key }}{% endif %}">{{ entry.title }}</a></h3>
    <p class="paper-authors">
      {%- for author in entry.author_array -%}
        {% unless forloop.first %}, {% endunless %}
        {%- assign last_name = author.last | remove: '*' -%}
        {%- if site.scholar.last_name contains last_name and site.scholar.first_name contains author.first -%}
          <strong>{{ author.first }} {{ last_name }}</strong>
        {%- else -%}
          {{ author.first }} {{ last_name }}
        {%- endif -%}
        {%- if author.last contains '*' -%}<sup title="Equal contribution">*</sup>{%- endif -%}
      {%- endfor -%}
    </p>
    <div class="paper-citation">{% include publication-venue.liquid %}</div>
    <div class="paper-links">
      {% if entry.pdf %}<a href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}">Paper</a>{% endif %}
      {% if project %}<a href="{{ project.url | relative_url }}#slides">Slides</a>{% endif %}
      {% if entry.code %}<a href="{{ entry.code }}">{% if entry.code contains 'github.com/' %}Code{% else %}Project site{% endif %}</a>{% endif %}
      {% if entry.abstract or entry.bibtex_show %}
        <details class="paper-details">
          <summary>{% if entry.abstract and entry.bibtex_show %}Abstract &amp; citation{% elsif entry.abstract %}Abstract{% else %}Citation{% endif %}</summary>
          {% if entry.abstract %}<p>{{ entry.abstract }}</p>{% endif %}
          {% if entry.bibtex_show %}<pre aria-label="BibTeX citation"><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre>{% endif %}
        </details>
      {% endif %}
    </div>
  </div>
</article>
