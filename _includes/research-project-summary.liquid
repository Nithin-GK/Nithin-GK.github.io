{% assign item = include.item %}
{% assign project = include.project %}
<article class="{% if include.industry %}industry-entry{% else %}project-entry{% unless project.image %} project-entry--text{% endunless %}{% endif %}">
  {% if include.industry %}
    <header class="industry-company">
      {% if include.sectioned %}
        <h3>{{ project.company }}</h3>
      {% else %}
        <h2>{{ project.company }}</h2>
      {% endif %}
      <p class="project-meta">
        <span>{{ project.role }}</span><span>{{ project.period }}</span>
      </p>
    </header>
  {% elsif project.image %}
    <a class="project-entry-image" href="{{ item.url | relative_url }}" aria-label="View {{ project.title | escape }}">
      <img src="{{ project.image | relative_url }}" alt="{{ project.image_alt | escape }}" width="800" height="500" loading="lazy" decoding="async">
    </a>
  {% endif %}
  <div>
    {% if include.industry %}
      <h3>
        <a href="{{ item.url | relative_url }}">{{ project.title }}</a>
      </h3>
    {% else %}
      <p class="project-meta">
        {{ project.venue }}
        {{ project.year }}
      </p>
      {% if include.sectioned %}
        <h3>
          <a href="{{ item.url | relative_url }}">{{ project.title }}</a>
        </h3>
      {% else %}
        <h2>
          <a href="{{ item.url | relative_url }}">{{ project.title }}</a>
        </h2>
      {% endif %}
    {% endif %}
    <p>
      {% if include.industry %}{{ project.industry_description | default: project.description }}{% else %}{{ project.description }}{% endif %}
    </p>
    <div class="project-links">
      <a href="{{ item.url | relative_url }}">View project</a>
      {% if project.links.size > 0 %}
        <a href="{{ project.links[0].url }}" target="_blank" rel="noopener noreferrer">{{ project.links[0].label }}</a>
      {% endif %}
    </div>
  </div>
</article>
