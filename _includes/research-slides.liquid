<section class="research-deck" tabindex="0" aria-label="{{ include.label | escape }} presentation" data-slide-viewer>
  <div class="research-deck-toolbar" hidden data-slide-controls>
    <span class="research-deck-count" data-slide-count>1 / {{ include.slides.size }}</span>
    <div class="research-deck-buttons">
      <button type="button" data-slide-prev aria-label="Previous slide" disabled>Previous</button>
      <button type="button" data-slide-next aria-label="Next slide">Next</button>
      <button type="button" data-slide-fullscreen hidden>Full screen</button>
    </div>
  </div>
  <div class="research-deck-stage" data-slide-stage>
    {% for key in include.slides %}
      {% assign slide = site.data.research_slides[key] %}
      <article class="research-slide" data-slide>
        <header>
          <h3>{{ slide.title | escape }}</h3>
          <p>{{ slide.takeaway | escape }}</p>
        </header>
        {% if slide.figure %}
          <figure class="research-slide-figure">
            <a href="{{ slide.figure | relative_url }}" target="_blank" rel="noopener" aria-label="View full-size figure for {{ slide.title | escape }}">
              <img src="{{ slide.figure | relative_url }}" alt="{{ slide.alt | escape }}" width="{{ slide.width }}" height="{{ slide.height }}" loading="lazy" decoding="async">
            </a>
          </figure>
        {% else %}
          {% assign table = slide.table %}
          {% if slide.project_table %}{% assign table = include.evidence %}{% endif %}
          {% include case-evidence.liquid evidence=table label=slide.title %}
        {% endif %}
        <a class="research-slide-original" href="{{ slide.original | relative_url }}" target="_blank" rel="noopener">Original slide</a>
      </article>
    {% endfor %}
  </div>
  <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-slide-status></span>
</section>
