{% assign first_slide_id = include.slides | first | append: '' %}
{% assign first_slide = site.data.research_slides[first_slide_id] %}
<section class="slide-viewer" tabindex="0" aria-label="{{ include.label | escape }}" data-slide-viewer>
  <div class="slide-viewer-stage">
    <img
      class="slide-viewer-image"
      src="{{ first_slide.src | relative_url }}"
      width="1600"
      height="900"
      alt="{{ first_slide.alt | escape }}"
      decoding="async"
      data-slide-image
    >
  </div>
  <div class="slide-viewer-controls" hidden data-slide-controls>
    <button type="button" data-slide-prev aria-label="Previous slide">Previous</button>
    <p class="slide-viewer-status" role="status" aria-live="polite" aria-atomic="true" data-slide-status>
      1 / {{ include.slides.size }} · {{ first_slide.title }}
    </p>
    <button type="button" data-slide-next aria-label="Next slide">Next</button>
    <button type="button" class="slide-viewer-fullscreen" data-slide-fullscreen hidden>Full screen</button>
  </div>
  <script type="application/json" data-slide-data>
    [
      {% for slide_id in include.slides %}
        {% assign key = slide_id | append: '' %}
        {% assign slide = site.data.research_slides[key] %}
        {"src": {{ slide.src | relative_url | jsonify }}, "title": {{ slide.title | jsonify }}, "alt": {{ slide.alt | jsonify }}}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>
<noscript><p>The first slide appears above. Enable JavaScript to browse the full presentation.</p></noscript>
