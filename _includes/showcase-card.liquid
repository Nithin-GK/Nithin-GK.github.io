{% assign project = site.data.research_projects[include.key] %}
{% assign story = site.data.project_showcase[include.key] %}
{% assign card_image = story.image %}
{% if include.industry and story.industry_image %}{% assign card_image = story.industry_image %}{% endif %}
<article class="showcase-card{% if include.featured %} showcase-card-featured{% endif %}" data-project-card data-theme="{{ story.theme | escape }}">
  <a class="showcase-card-media" href="{{ '/projects/' | append: include.key | append: '/' | relative_url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ card_image | relative_url }}" alt="" loading="lazy" decoding="async">
  </a>
  <div class="showcase-card-copy">
    <p class="showcase-eyebrow">
      {% if include.industry -%}
        {{- project.company }} · {{ project.period -}}
      {%- else -%}
        {{- project.venue }}
        {{ project.year -}}
      {%- endif %}
    </p>
    <h3>
      <a href="{{ '/projects/' | append: include.key | append: '/' | relative_url }}">{{ project.title }}</a>
    </h3>
    <p>{{ story.pitch }}</p>
    <a class="showcase-project-link" href="{{ '/projects/' | append: include.key | append: '/' | relative_url }}"
      >View project<span aria-hidden="true"> ↗</span></a
    >
  </div>
</article>
